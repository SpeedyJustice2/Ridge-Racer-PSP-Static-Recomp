# Build output
/out/
/build/
/Testing/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json
CMakeUserPresets.json

# Build directories created outside /out/ (per-stage trees use names like b457_perf)
b*_perf/
cmake-build-*/

# Binary build artifacts, wherever they land
*.exe
*.dll
*.lib
*.obj
*.exp
*.iobj
*.ipdb
*.res
*.tlog
*.o
*.a
*.so
*.so.*
*.dylib
*.pch
*.idb
*.ipch

# Copyrighted game data.  Never publish: the PSP executable, its decrypted ELF
# and save data are the user's own dumped media, not part of this source tree.
PSP_DATA/
SAVEDATA/
*.ELF
*.elf
*.iso
*.cso
EBOOT*.BIN
BOOT.BIN
*.pbp
*.PBP
*.prx
*.PRX
*.at3
*.pmf

# User-owned game data and reverse-engineering workspace
/profiles/*/game/
/profiles/*/analysis/
/profiles/*/progress/
/profiles/*/captures/

# Generated scratch output (the checked-in profile corpus is not ignored)
*.generated
*.tmp
*.log
*.pdb
*.ilk
*.dmp
*.mdmp
*_crash.txt

# IDE files
.vs/
.vscode/
.idea/
*.user
*.suo
*.VC.db
*.VC.VC.opendb
/.cache/

# Local command-output scratch files
/dir
/gh

# Python
__pycache__/
*.pyc


# Vendored controller library the MotorStorm build links against
!profiles/motorstorm/third_party/SDL3/bin/SDL3.dll
!profiles/motorstorm/third_party/SDL3/lib/x64/SDL3.lib

/generated/
/RidgeRacer-Beta/

# ---- Ridge Racer port: build outputs, packaging and local test material ----
/toolchain/
/dist/
/build-linux/
/RidgeRacer-Unix/
/RidgeRacer-Linux/
/rr-clean-test.log
/rr-clean-test.cmd
/rrtest.cmd
/rr-installer-test.cmd
/savedata/
/screenshots/
/ramdumps/
Setup-log.txt
install.log

# Debug logs, audio dumps and captures that pile up in the repo root
/*.txt
!/CMakeLists.txt
*.wav
*.raw
*.png
!/profiles/**/*.png
# Browser build output: contains the game's translated code, must never be published
/build-web/
/web-dist/

# Ridge Racer: the bundled SDL2 runtime is part of the source (the *.dll rule above would drop it)
!profiles/ridgeracer/third_party/sdl2/SDL2.dll
# Crash and bug reports written next to the game
/reports/
RidgeRacer-bug-report-*.zip
# Cloudflare / wrangler local state (account ids)
.wrangler/
node_modules/
# Code signing settings (your Azure account details); the example file is published
/sign-release.cmd
